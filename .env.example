# Local development only. Compose binds database/API ports to loopback.
METADATA_PASSWORD=local-metadata
BENCH_PASSWORD=local-bench
ML_METADATA_URL=postgresql+psycopg://criterion:local-metadata@localhost:55432/criterion
ML_BENCH_DSN=postgresql://bench:local-bench@localhost:55433/bench
ML_POLL_SECONDS=1
ML_HEARTBEAT_SECONDS=5
ML_LEASE_SECONDS=30
# The diagnostic executor is opt-in; benchmarks are available independently.
ML_ENABLE_DIAGNOSTIC_JOBS=false
# For local execution outside Docker; API and worker must share this path.
ML_ARTIFACT_ROOT=./artifacts/results
ML_SOURCE_SCHEMAS=["public"]
ML_MAX_DATASET_ROWS=1000000
ML_SKLEARN_MEMORY_MB=512
ML_RESOURCE_SAMPLE_SECONDS=0.1
